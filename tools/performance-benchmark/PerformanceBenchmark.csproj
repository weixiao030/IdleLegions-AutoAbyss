<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>FrostAbyss.PerformanceBenchmark</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/*.cs"/><Compile Include="PerformanceBenchmark.cs"/>
    <EmbeddedResource Include="../../app/Assets/app.ico" LogicalName="app.ico"/>
    <EmbeddedResource Include="../../shared/*.json" LogicalName="%(Filename)%(Extension)"/>
    <EmbeddedResource Include="../../ui/dist/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
