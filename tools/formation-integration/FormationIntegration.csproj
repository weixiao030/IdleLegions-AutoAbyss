<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>FrostAbyss.FormationIntegration</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/*.cs" />
    <Compile Include="Entry.cs" />
    <EmbeddedResource Include="../../app/Assets/app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="../../shared/professions.json" LogicalName="professions.json" />
    <EmbeddedResource Include="../../shared/elites.json" LogicalName="elites.json" />
    <EmbeddedResource Include="../../ui/dist/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
