<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><StartupObject>FrostAbyss.SearchBenchmark</StartupObject><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
 <ItemGroup>
  <Compile Include="../../app/*.cs"/><Compile Include="SearchBenchmark.cs"/>
  <EmbeddedResource Include="../../app/Assets/app.ico" LogicalName="app.ico"/>
  <EmbeddedResource Include="../../shared/professions.json" LogicalName="professions.json"/>
  <EmbeddedResource Include="../../shared/elites.json" LogicalName="elites.json"/>
  <EmbeddedResource Include="../../shared/card-catalog.json" LogicalName="card-catalog.json"/>
  <EmbeddedResource Include="../../shared/game-text-zh.json" LogicalName="game-text-zh.json"/>
  <EmbeddedResource Include="../../shared/strategy4-defaults.json" LogicalName="strategy4-defaults.json"/>
  <EmbeddedResource Include="../../ui/dist/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)"/>
 </ItemGroup>
</Project>
