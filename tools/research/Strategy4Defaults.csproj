<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>FrostAbyss.Strategy4DefaultsGenerator</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/*.cs"/><Compile Include="Strategy4Defaults.cs"/>
    <EmbeddedResource Include="../../shared/professions.json" LogicalName="professions.json"/>
    <EmbeddedResource Include="../../shared/elites.json" LogicalName="elites.json"/>
    <EmbeddedResource Include="../../shared/game-text-zh.json" LogicalName="game-text-zh.json"/>
    <EmbeddedResource Include="../../shared/card-catalog.json" LogicalName="card-catalog.json"/>
    <EmbeddedResource Include="../../shared/strategy4-defaults.json" LogicalName="strategy4-defaults.json"/>
  </ItemGroup>
</Project>
